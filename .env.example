# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# --- Supabase ---
# URL y key del proyecto Supabase. En desarrollo local con la CLI, estos
# valores los imprime `supabase start` (usá la API URL y la service_role key).
# La service_role key es secreta: no debe exponerse al frontend.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=tu-service-role-key

# Bucket (privado) para las fotos de docentes. Opcional (default: docentes-fotos).
SUPABASE_BUCKET_DOCENTES=docentes-fotos

# --- CORS ---
# Orígenes permitidos para el frontend (lista separada por comas).
# Opcional (default: * = todos). En producción restringir al dominio del front:
#   CORS_ORIGINS=https://ids-web.vercel.app,http://localhost:5000
CORS_ORIGINS=*

# --- Cache ---
# Segundos de cache en el CDN para los GET públicos (Vercel los sirve desde el
# edge sin invocar la función). Opcional (default: 300). 0 desactiva el cache.
CACHE_MAX_AGE=300

# --- API key ---
# Restringe el consumo al frontend (ids-web): si tiene valor, toda request debe
# enviar el header X-API-Key con esta clave. Vacío = API pública (sin key).
# Debe coincidir con la que configure ids-web. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- Configuración JWT ---
# Clave con la que se firman los tokens. En cualquier ambiente que no sea
# desarrollo local, usá una clave propia y larga. Podés generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please
JWT_EXPIRACION_HORAS=8

# --- Credenciales del panel de administración (único usuario) ---
# ADMIN_PASSWORD es un HASH bcrypt del password (no el password en texto plano).
# Generá el hash con:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'tu-password', bcrypt.gensalt()).decode())"
ADMIN_USER=admin
ADMIN_PASSWORD=$2b$12$replace-with-a-real-bcrypt-hash
